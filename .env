# ============================================================
#  Telegram MTProto Credentials (https://my.telegram.org)
#  دریافت API_ID و API_HASH از بخش API development tools
# ============================================================
TG_API_ID=33464424
TG_API_HASH=62bc68ac86414304e727cd6834470d7d
TG_PHONE=+17409216751
TG_SESSION_NAME=ig_monitor_session
TG_CHANNEL_ID=-1003952743194
TG_CHANNEL_USERNAME=@instagram_tester

# پروکسی تلگرام (مهم برای Railway - بدون پروکسی، اتصال timeout میده)
# فرمت‌های قابل استفاده:
#   socks5://user:pass@host:port  — پروکسی مشخص شده
#   socks5://host:port             — پروکسی بدون احراز هویت
#   auto                           — پیدا کردن خودکار پروکسی سالم از لیست
#
# اگه auto بذارید، ربات به‌صورت خودکار از لیست پروکسی‌های TheSpeedX/PROXY-List،
# یه SOCKS5 سالم پیدا می‌کنه که به تلگرام وصل بشه. این گزینه برای Railway عالیه!
#
# اگه خالی باشه، ربات مستقیم وصل میشه (در Railway کار نمیکنه)
TG_PROXY=

# ============================================================
#  Instagram Credentials (اکانت برنر/فیک پیشنهاد میشه)
#  برای لاگین اول استفاده میشه، بعدش session ذخیره میشه
# ============================================================
IG_USERNAME=academy_barfi
IG_PASSWORD=Ali54248590

# ============================================================
#  Instagram 2FA (اختیاری - فقط اگه اکانت 2FA فعال داره)
# ============================================================
IG_2FA_SECRET=
IG_2FA_CODE=

# ============================================================
#  Monitoring Configuration
# ============================================================
# لیست اکانت‌های IG که میخواید مانیتور بشن (با کاما جدا کنید)
TARGET_ACCOUNTS=ba3iraa

# فواصل چک کردن (ثانیه)
# FIX(checkpoint): مقادیر قبلی ۵۰/۹۰ ثانیه بسیار تهاجمی بود و باعث
# rate-limit و checkpoint_required می‌شد. حداقل امن: ۳۰۰/۴۲۰ ثانیه.
POLL_INTERVAL_POSTS=300
POLL_INTERVAL_STORIES=420

# فیلتر کلمات کلیدی (اختیاری - با کاما جدا کنید)
# اگه خالی باشه همه پست‌ها ارسال میشه
KEYWORD_FILTER=

# فیلتر بر اساس هشتگ (اختیاری)
HASHTAG_FILTER=

# ============================================================
#  Proxy Configuration
# ============================================================
# روش پروکسی: none | list | static
PROXY_MODE=list
# آدرس آپدیت لیست پروکسی (TheSpeedX/PROXY-List)
PROXY_LIST_URL_HTTP=https://raw.githubusercontent.com/TheSpeedX/PROXY-List/master/http.txt
PROXY_LIST_URL_SOCKS=https://raw.githubusercontent.com/TheSpeedX/PROXY-List/master/socks5.txt
# فاصله آپدیت لیست پروکسی (ساعت)
PROXY_LIST_UPDATE_HOURS=3
# پروکسی ثابت (اگه PROXY_MODE=static)
PROXY_STATIC_URL=
# Timeout پروکسی (میلی‌ثانیه)
PROXY_TIMEOUT=10000

# ============================================================
#  Storage Paths
# ============================================================
DATA_DIR=./data
DB_PATH=./data/app.db
IG_SESSION_DIR=./data/ig-sessions
TG_SESSION_DIR=./data/tg-session
MEDIA_DIR=./data/media
PROXY_DIR=./data/proxies

# ============================================================
#  Worker / Queue Configuration
# ============================================================
MAX_CONCURRENT_DOWNLOADS=3
MAX_CONCURRENT_SENDS=2
DOWNLOAD_TIMEOUT=60000
SEND_TIMEOUT=120000

# ============================================================
#  Anti-Detection Settings
# ============================================================
# تاخیر تصادفی بین درخواست‌ها (میلی‌ثانیه)
# FIX(checkpoint): افزایش از ۲۰۰۰/۵۰۰۰ به ۳۰۰۰/۷۰۰۰ برای کاهش ریسک
REQUEST_DELAY_MIN=3000
REQUEST_DELAY_MAX=7000
# تغییر User-Agent تصادفی
# FIX(bug-ua): باید FALSE باشد. UA باید با session ساخته‌شده ثابت بماند.
# اگر TRUE باشد، سشن اینستاگرام بلافاصله نامعتبر می‌شود.
ROTATE_USER_AGENT=false
# Logout بعد از هر درخواست (برای کاهش ریسک، باعث افت سرعت میشه)
LOGOUT_AFTER_REQUEST=false

# ============================================================
#  Logging
# ============================================================
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE=./data/app.log

# ============================================================
#  Railway/Production
# ============================================================
NODE_ENV=production
# در Railway این متغیر خودکار تنظیم میشه
PORT=3000

# FIX(security): توکن محافظت /debug در production. یک رشته‌ی تصادفی طولانی بسازید.
# مثال: openssl rand -hex 32
# بدون این، مسیرهای /debug و /stats در production عمومی هستند.
DEBUG_API_TOKEN=a9f82k29s7d92ksl2m

# FIX(security): هشدار مهم — این فایل حاوی اطلاعات حساس است.
# اگر این فایل را به اشتراک گذاشتید (مثل zip)، تمام رمزها را عوض کنید:
#   1. رمز اینستاگرام: instagram.com → Settings → Security → Password
#   2. API hash تلگرام: my.telegram.org → API development tools → Revoke
#   3. Bot token تلگرام: @BotFather → /revoke
#   4. فایل ig-session-base64.txt را حذف کنید و سشن جدید بسازید

# ============================================================
#  Alerts / Notifications
# ============================================================
# آیدی چت برای دریافت alertها (اختیاری - اگه خالی باشه، خطاها به کانال اصلی میرن)
ALERT_CHAT_ID=8491968448
# ارسال آمار روزانه
DAILY_STATS_ENABLED=true
DAILY_STATS_HOUR=9

# ============================================================
#  Bot Manager (ربات مدیریت تلگرام)
# ============================================================
# توکن ربات مدیریت — از @BotFather بگیرید
# این ربات برای کنترل ربات مانیتور از طریق تلگرام استفاده میشه
# (با دستورات /status, /add, /remove, /poll, /restart و ...)
TG_BOT_TOKEN=8605687961:AAGtX93BKbzQsS0tbRj1oV0JsmSG4K-qWEE


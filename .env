# پروکسی تلگرام (مهم برای ایران - بدون پروکسی، اتصال timeout میده)
# فرمت‌های قابل استفاده:
#   socks5://user:pass@host:port  — پروکسی مشخص شده
#   socks5://host:port             — پروکسی بدون احراز هویت
#   auto                           — پیدا کردن خودکار پروکسی سالم از لیست
#
# FIX(iran): در ایران، اتصال مستقیم به تلگرام (حتی WSS) معمولاً مسدود می‌شود.
# ربات اول تلاش مستقیم می‌کند، اگه fail شد، به‌طور خودکار SOCKS5 پیدا می‌کند.
# اگه auto کار نکرد، یک پروکسی SOCKS5 پولی تنظیم کنید:
#   TG_PROXY=socks5://user:pass@stable-host:port
TG_PROXY=auto

# ============================================================
#  Instagram Credentials (اکانت برنر/فیک پیشنهاد میشه)
#  برای لاگین اول استفاده میشه، بعدش session ذخیره میشه
# ============================================================
IG_USERNAME=academy_barfi
IG_PASSWORD=Ali54248590

# ============================================================
#  Instagram 2FA (اختیاری - فقط اگه اکانت 2FA فعال داره)
# ============================================================
IG_2FA_SECRET=
IG_2FA_CODE=

# ============================================================
#  Monitoring Configuration
# ============================================================
# لیست اکانت‌های IG که میخواید مانیتور بشن (با کاما جدا کنید)
TARGET_ACCOUNTS=botfoori,ba3iraa,rasanknews

# فواصل چک کردن (ثانیه)
# v2 PROFESSIONAL: بر اساس تحقیق پروژه‌های GitHub (InstaMonitorBot)
# و مستندات instagrapi، حداقل امن ۱۵ دقیقه (۹۰۰ ثانیه) برای پست‌هاست.
# استوری‌ها هر ۳۰ دقیقه (۱۸۰۰ ثانیه) چک می‌شوند — استوری‌ها ۲۴ ساعت عمر دارند.
#
# مهم: حتی با این فواصل، تعداد اکانت‌های مانیتور‌شده نباید از ۱۰-۱۵ تجاوز کند.
# با ۳ اکانت و این فواصل، مصرف درخواست ~۳۰ درخواست/ساعت است (بسیار امن).
POLL_INTERVAL_POSTS=900
POLL_INTERVAL_STORIES=1800

# فیلتر کلمات کلیدی (اختیاری - با کاما جدا کنید)
# اگه خالی باشه همه پست‌ها ارسال میشه
KEYWORD_FILTER=

# فیلتر بر اساس هشتگ (اختیاری)
HASHTAG_FILTER=

# ============================================================
#  Proxy Configuration
# ============================================================
# روش پروکسی: none | list | static
# FIX: list برای اینستاگرام و auto-proxy تلگرام استفاده می‌شود
PROXY_MODE=list
# آدرس آپدیت لیست پروکسی (TheSpeedX/PROXY-List)
PROXY_LIST_URL_HTTP=https://raw.githubusercontent.com/TheSpeedX/PROXY-List/master/http.txt
PROXY_LIST_URL_SOCKS=https://raw.githubusercontent.com/TheSpeedX/PROXY-List/master/socks5.txt
# فاصله آپدیت لیست پروکسی (ساعت)
PROXY_LIST_UPDATE_HOURS=3
# پروکسی ثابت (اگه PROXY_MODE=static)
# FIX: خالی گذاشتن این مقدار مهم است — اگه placeholder باشد، ربات خطا می‌دهد
PROXY_STATIC_URL=
# Timeout پروکسی (میلی‌ثانیه)
PROXY_TIMEOUT=10000

# ============================================================
#  Storage Paths
# ============================================================
DATA_DIR=./data
DB_PATH=./data/app.db
IG_SESSION_DIR=./data/ig-sessions
TG_SESSION_DIR=./data/tg-session
MEDIA_DIR=./data/media
PROXY_DIR=./data/proxies

# ============================================================
#  Worker / Queue Configuration
# ============================================================
MAX_CONCURRENT_DOWNLOADS=3
MAX_CONCURRENT_SENDS=2
DOWNLOAD_TIMEOUT=60000
SEND_TIMEOUT=120000

# ============================================================
#  Anti-Detection Settings
# ============================================================
# تاخیر تصادفی بین درخواست‌ها (میلی‌ثانیه)
# v2: ۵-۱۰ ثانیه بین درخواست‌ها (instagrapi توصیه ۱-۳ ثانیه حداقل)
REQUEST_DELAY_MIN=5000
REQUEST_DELAY_MAX=10000
# تغییر User-Agent تصادفی
# FIX(bug-ua): باید FALSE باشد. UA باید با session ساخته‌شده ثابت بماند.
# اگر TRUE باشد، سشن اینستاگرام بلافاصله نامعتبر می‌شود.
ROTATE_USER_AGENT=false
# Logout بعد از هر درخواست (برای کاهش ریسک، باعث افت سرعت میشه)
LOGOUT_AFTER_REQUEST=false

# Cooldown های اینستاگرام (ثانیه)
IG_RATE_LIMIT_COOLDOWN=900
IG_CHALLENGE_COOLDOWN=3600
IG_RECONNECT_INTERVAL=600
SCHEDULE_JITTER_PERCENT=20
IG_PROFILE_CACHE_TTL=86400
FEED_FETCH_LIMIT=12

# ============================================================
#  Logging
# ============================================================
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE=./data/app.log

# ============================================================
#  Railway/Production
# ============================================================
NODE_ENV=production
# در Railway این متغیر خودکار تنظیم میشه
PORT=3000

# FIX(security): توکن محافظت /debug در production.
# این توکن را برای دسترسی به /debug استفاده کنید:
#   curl -H "Authorization: Bearer 7cd9797fad542d5f3d9b5d55fadbbb22ac247dddba7e4ff1ff89422437422602" https://your-app.railway.app/debug
DEBUG_API_TOKEN=7cd9797fad542d5f3d9b5d55fadbbb22ac247dddba7e4ff1ff89422437422602

# FIX(security): هشدار مهم — این فایل حاوی اطلاعات حساس است.
# اگر این فایل را به اشتراک گذاشتید (مثل zip)، تمام رمزها را عوض کنید:
#   1. رمز اینستاگرام: instagram.com → Settings → Security → Password
#   2. API hash تلگرام: my.telegram.org → API development tools → Revoke
#   3. Bot token تلگرام: @BotFather → /revoke
#   4. فایل ig-session-base64.txt را حذف کنید و سشن جدید بسازید

# ============================================================
#  Alerts / Notifications
# ============================================================
